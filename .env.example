# Copy this file to .env and change what you need:
#   cp .env.example .env
# Docker works fine without a .env file too, these are the same defaults it uses.

# ---- Ports on your machine ----
# the website (Docker)
CLIENT_PORT=3000
# the Express API
API_PORT=8000
# MySQL. 3307 so it doesn't clash with a MySQL you may already have on 3306
DB_PORT=3307
# inbox for test emails
MAILPIT_PORT=8025

# ---- Database ----
DB_NAME=online_library
DB_USER=library
DB_PASSWORD=library
DB_ROOT_PASSWORD=root
DB_TIMEZONE=+07:00
# Only used when you run the API outside Docker (npm run dev). Docker uses "db".
DB_HOST=127.0.0.1

# ---- Login tokens ----
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=8h

# ---- Library rules ----
LOAN_DAYS=14
# Fill the database with demo accounts, books and loans on first start.
SEED_DEMO_DATA=true

# ---- Email ----
# By default emails go to Mailpit (http://localhost:8025), nothing is really sent.
# These two are used when you run the API outside Docker:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# To send real email (Gmail example, needs an App Password), set these and the two Docker ones:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
#   DOCKER_SMTP_HOST=smtp.gmail.com   DOCKER_SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Online Library <no-reply@library.local>
